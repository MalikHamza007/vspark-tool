# Frontend config lives in src/environments/environment.ts (publishable values only).
# Server-side secrets are set on Supabase, never in this repo:
#   supabase secrets set GEMINI_API_KEY=... --project-ref <ref>
#   supabase secrets set RESEND_API_KEY=... EMAIL_FROM="VSpark <onboarding@resend.dev>" --project-ref <ref>
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RESEND_API_KEY=
EMAIL_FROM=VSpark <onboarding@resend.dev>
GOOGLE_CLIENT_ID=
